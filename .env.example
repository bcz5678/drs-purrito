# Copy to .env for local development. In production these are set as
# environment variables in Coolify — this file is never read there.

# OpenAI API key used by src/routes/api/generate-purrito.ts to generate
# the Purrito product image via gpt-image-1.
OPENAI_API_KEY=

# Optional overrides. Defaults: gpt-image-1 at medium quality.
# Try OPENAI_IMAGE_MODEL=gpt-image-1.5 or gpt-image-1-mini, and quality low/medium/high.
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium
